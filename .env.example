JIRA_BASE_URL=https://certifyos.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TS
OPENROUTER_API_KEY=
OPENROUTER_ESCALATION_ENABLED=false
OPENROUTER_MODEL=openai/gpt-oss-120b:free
OPENROUTER_FALLBACK_MODEL=openai/gpt-oss-120b:free
OPENROUTER_REASONING_ENABLED=true
# Optional tuning for OpenRouter retries/timeouts
OPENROUTER_MAX_RETRIES=4
OPENROUTER_REQUEST_TIMEOUT_MS=45000
OPENROUTER_BASE_DELAY_MS=500

# HuggingFace Router (alternative escalation provider)
# Set ESCALATION_PROVIDER=huggingface to use this instead of OpenRouter.
# Defaults to "openrouter" when unset.
# Note: OPENROUTER_ESCALATION_ENABLED=true (above) is the master switch for
# escalation triage and is required regardless of which provider you choose -
# setting only the HF_* vars below does not turn triage on.
ESCALATION_PROVIDER=openrouter
HF_TOKEN=
HF_MODEL=google/gemma-4-31B-it:novita
HF_FALLBACK_MODEL=openai/gpt-oss-120b:novita

# ML anomaly-model fallback (see ml/README below / mlEscalationModel.ts).
# Disabled by default: it was over-flagging most tickets in "waiting" categories
# as "immediate" (trained on recently-created tickets, which skews fresh -
# lingering "waiting" tickets look anomalous on age features alone). When
# disabled, the fallback chain is OpenRouter/HF -> local rule-based heuristic,
# same as before the ML model existed. Set to true only after retraining on a
# distribution that matches what each category contains at inference time.
ML_ESCALATION_ENABLED=false
