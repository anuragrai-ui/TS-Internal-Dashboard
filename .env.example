JIRA_BASE_URL=https://certifyos.atlassian.net
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=TS

# Upstash Redis (REST client) - required for the category/snapshot/analysis
# caches, the follow-up cooldown + audit log, and Slack mention storage.
# Provision via the Vercel Marketplace (Upstash for Redis) or upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Vercel Cron auth for app/api/cron/refresh - Vercel attaches this header
# automatically on Cron-triggered requests once this is set as a project env
# var. Required in production; without it the route always returns 401.
CRON_SECRET=

# Encrypts per-team-member Jira API tokens at rest in Redis (see /settings/jira-tokens,
# src/lib/userJiraTokens.ts, src/lib/tokenCrypto.ts) - AES-256-GCM, 32 raw bytes,
# base64-encoded. Generate with: openssl rand -base64 32
# Required only for the per-user-token feature; without it, registration is
# refused with a clear error and every follow-up keeps using the shared
# service account exactly as before - not a crash for the rest of the app.
# Losing this key makes every already-registered token unrecoverable (by
# design - re-registering is the only way back, not a silent plaintext leak).
TOKEN_ENCRYPTION_KEY=

OPENROUTER_ESCALATION_ENABLED=false

# Active escalation-RISK-TRIAGE provider (immediate/watch/low scoring only -
# see openrouterEscalation.ts/mlEscalationModel.ts): openrouter | nvidia | mistral | anthropic
# Note: OPENROUTER_ESCALATION_ENABLED=true (above) is the master switch for
# escalation triage AND draft generation, and is required regardless of which
# provider(s) you choose below. This axis is independent from DRAFT_PROVIDER
# further down, which controls follow-up/closure DRAFT generation instead -
# the two features can run on different providers.
# OpenRouter (qwen/qwen3.7-flash below) is the default here: Mistral was the
# default previously but started returning 429 (rate limited) under normal
# use; NVIDIA's free tier is too slow (see below). See below for the other
# options and why they aren't the default for triage specifically.
ESCALATION_PROVIDER=openrouter

# Mistral (api.mistral.ai) - alternative provider.
# Caution: mistral-small-2603 was previously the default here but was
# observed returning 429 (rate limited) repeatedly under normal use - not a
# one-off, every attempt in the retry budget failed the same way. Revisit as
# default if you're on a higher Mistral rate-limit tier.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-2603
MISTRAL_FALLBACK_MODEL=

# NVIDIA NIM (integrate.api.nvidia.com) - alternative provider.
# Caution: the free/trial tier's shared inference queue has been measured
# taking anywhere from ~25s to 3+ minutes for the SAME model/key - unrelated
# to model choice, just queue depth on NVIDIA's side. In one live test, all 5
# chained models timed out and the whole request took 89s. To absorb slow
# individual models, NVIDIA_MODELS is an ORDERED CHAIN, not a single model:
# each entry gets exactly one attempt (NVIDIA_CHAIN_MAX_RETRIES, no backoff)
# within NVIDIA_CHAIN_TIMEOUT_MS before moving to the next - but this only
# helps if at least one model responds quickly, which the free tier does not
# reliably do. Leave NVIDIA_MODELS unset to use the built-in default chain:
# nemotron-3.5-lightning-30b-a3b, deepseek-v4-flash, gpt-oss-120b,
# nemotron-3-ultra-550b, kimi-k3. Reconsider as default if you get a paid/
# dedicated NVIDIA key, or if the free tier's latency improves.
NVIDIA_API_KEY=
NVIDIA_MODELS=
NVIDIA_CHAIN_TIMEOUT_MS=15000
NVIDIA_CHAIN_MAX_RETRIES=1

# OpenRouter (api.openrouter.ai) - default provider (see above).
# qwen/qwen3.7-flash confirmed live against OpenRouter's /api/v1/models
# catalog: a cheap, fast "flash"-tier model (~$0.03/$0.13 per M prompt/
# completion tokens at low volume, 1M context). Billed per-request against
# your OpenRouter account; verify pricing before use.
# Caution: openai/gpt-oss-120b:free was confirmed dead (404, "unavailable for
# free") as of this writing - OpenRouter discontinued that free slug. If you
# switch models, double-check the slug against /api/v1/models rather than
# assuming it's still served.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.7-flash
OPENROUTER_FALLBACK_MODEL=qwen/qwen3.7-flash
OPENROUTER_REASONING_ENABLED=true
# Optional tuning for OpenRouter's own retry/backoff (unrelated to the NVIDIA chain above)
OPENROUTER_MAX_RETRIES=4
OPENROUTER_REQUEST_TIMEOUT_MS=45000
OPENROUTER_BASE_DELAY_MS=500

# Follow-up/closure DRAFT generation provider (independent from
# ESCALATION_PROVIDER above, which is risk-triage only): openrouter | nvidia | mistral | anthropic
# Defaults to anthropic - every outbound message a human or client actually
# reads (CP escalations, SLA/product-wait follow-ups, closure messages) is
# drafted by Claude. Falls back to the fixed hardcoded template exactly like
# a missing API key on any other provider (see draftViaChain in
# followupDraft.ts), so leaving ANTHROPIC_API_KEY unset is safe, not a crash
# - it just means every draft uses the template fallback until it's set.
DRAFT_PROVIDER=anthropic

# Anthropic (api.anthropic.com) - default draft provider (see above).
# claude-haiku-4-5-20251001: cheap, fast, and - via the systemPrompt option
# in llmClient.ts - supports prompt caching. Every draft's instruction
# preamble (role, formatting rules, audience-specific framing) is sent as a
# cached system block; the many similar drafts one cron batch generates
# (dozens of CP escalations, dozens of external product-wait follow-ups)
# reuse that cached prefix instead of paying full input price on each one -
# only the small per-ticket JSON payload is priced at full input rate every
# time. Get a key at console.anthropic.com.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_FALLBACK_MODEL=

# Concurrency cap for per-ticket Jira comment lookups in getActionableItems()
# (each candidate ticket needs one comment fetch to decide if it's actionable).
# Higher = faster category loads, more simultaneous requests to Jira. Default 8.
JIRA_FETCH_CONCURRENCY=8

# ML anomaly-model fallback (see ml/README below / mlEscalationModel.ts).
# Disabled by default: it was over-flagging most tickets in "waiting" categories
# as "immediate" (trained on recently-created tickets, which skews fresh -
# lingering "waiting" tickets look anomalous on age features alone). When
# disabled, the fallback chain is the active provider -> local rule-based
# heuristic, same as before the ML model existed. Set to true only after
# retraining on a distribution that matches what each category contains at
# inference time.
ML_ESCALATION_ENABLED=false

# Mistral OCR (api.mistral.ai/v1/ocr) - extracts text from image/PDF ticket
# attachments (max 15MB each) and feeds it into escalation analysis and
# follow-up drafts as additional context. Uses MISTRAL_API_KEY above - no
# separate key needed. Runs as best-effort background enrichment (after() on
# category-page/draft requests, cached in Redis for 30 days per attachment) so
# it never adds latency to a page load; results appear on a later view once
# cached. Requires Redis to be configured - silently skipped otherwise.
MISTRAL_OCR_MODEL=mistral-ocr-2512

# Max tickets per category sent to the LLM for escalation-risk analysis.
# Defaults to 25 if unset.
ESCALATION_ANALYSIS_LIMIT=25

# Closure-candidates scan (app/closure-candidates, src/lib/closureCandidates.ts).
# Max open TS tickets sent to the LLM in one batched "is this a duplicate of
# an already-resolved ticket" judgment call, after the free linked-CP-done
# check. Defaults to 20 if unset.
CLOSURE_SIMILARITY_LIMIT=20

# Timezone for Weekly Closures week boundaries (Monday start). Should match the
# Jira service account's timezone, since Jira reads JQL date literals in it.
WEEKLY_REPORT_TIMEZONE=America/Los_Angeles

# Follow-up feature (draft-then-confirm Jira comment via
# app/api/tickets/[key]/followup/*). Hours to block a repeat send on the
# same ticket after one succeeds. Defaults to 24 if unset.
FOLLOWUP_COOLDOWN_HOURS=24

# Slack Events API integration (app/api/slack/events). Signing secret from
# your Slack app's "Basic Information" page - used to verify incoming
# webhook requests are genuinely from Slack. Required for the webhook route
# to accept any event; leave unset to reject everything.
SLACK_SIGNING_SECRET=

# Slack posting for the agent-followups cron (app/api/cron/agent-followups,
# src/lib/slackApi.ts) AND the SLA-breach Slack alert (SLA Follow-Ups tab,
# "Alert POD (Slack)" - see src/lib/slaBreachAlert.ts). Needs its own bot
# token with the chat:write scope - a separate concern from
# SLACK_SIGNING_SECRET above, which only verifies inbound webhooks. Leave
# unset to run the cron with the Slack summary step skipped (drafts are
# still prepared either way) and the SLA-breach alert unable to post.
#
# The SLA-breach alert also tags the blocking CP's POD's Product Manager by
# @-mention - this needs the ADDITIONAL users:read.email scope, since it
# resolves a Jira display name to a Slack user via a guessed
# firstname.lastname@certifyos.com address and Slack's users.lookupByEmail.
# Missing this scope (or a guessed email that doesn't match) isn't a hard
# failure - the alert still posts, just with a plain-text @name instead of a
# real ping.
SLACK_BOT_TOKEN=
SLACK_AGENT_FOLLOWUP_CHANNEL=

# Vercel Cron auth for app/api/cron/agent-followups - reuses CRON_SECRET
# above, no separate var needed.

# Google Sheet data source. Defaults match the TS tickets Backlog workbook;
# override these only when moving the dashboard to another workbook or tabs.
GOOGLE_SHEET_ID=1EfCH8LOevjTBZsWzkiiD4RdyXwf82CypiAJEcpa7V-U
GOOGLE_SHEET_BACKLOG_GID=0
GOOGLE_SHEET_FOLLOWUPS_GID=957104001

# Write access to the sheet (src/lib/googleSheetsWriter.ts) - separate from
# the read-only public-CSV-export access above, which has no auth and can't
# write. Every follow-up sent (any kind - manual, SLA, CP escalation,
# product-wait, closure) is logged as a row in the "Follow-Up Log" tab, as a
# durable record independent of the Redis audit log (which is capped/TTL'd
# for memory reasons - see followupAudit.ts).
#
# Deliberately NOT a Google Cloud service account - that needs IAM Admin
# access to create, which isn't available here. Instead this posts to a
# Google Apps Script Web App bound to the spreadsheet, set up entirely from
# the Sheets UI by anyone who can already edit the sheet:
#   1. Open the Google Sheet -> Extensions -> Apps Script
#   2. Replace the editor's contents with:
#
#        function doPost(e) {
#          var ss = SpreadsheetApp.getActiveSpreadsheet();
#          var sheet = ss.getSheetByName("Follow-Up Log");
#          if (!sheet) {
#            sheet = ss.insertSheet("Follow-Up Log");
#            sheet.appendRow(["Posted At", "Issue Key", "Kind", "Status", "Jira Comment ID", "Message Text"]);
#          }
#          var payload = JSON.parse(e.postData.contents);
#          payload.values.forEach(function (row) { sheet.appendRow(row); });
#          return ContentService.createTextOutput(JSON.stringify({ ok: true }))
#            .setMimeType(ContentService.MimeType.JSON);
#        }
#
#   3. Deploy -> New deployment -> type "Web app" -> Execute as "Me" ->
#      Who has access "Anyone" -> Deploy -> authorize when prompted (this is
#      your own Google account approving the script, a one-time consent
#      click - not a service account)
#   4. Copy the resulting web app URL (ends in /exec) into
#      GOOGLE_SHEET_WEBHOOK_URL below
# Leaving this unset is safe - appendFollowUpLogRow/Rows just returns false
# and logs nothing, same graceful-degradation pattern as every other
# optional integration in this codebase. Re-running "Deploy -> Manage
# deployments -> Edit -> New version" is required after editing the script
# for changes to take effect - the URL stays the same across versions.
GOOGLE_SHEET_WEBHOOK_URL=
